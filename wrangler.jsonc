{
  "name": "getlocation",
  "compatibility_date": "2026-08-14",
  // main : Worker compilé à partir de functions/api/*.js (npm run
  // build:worker, ou `npx wrangler pages functions build
  // --outdir=./dist/worker/`) — nécessaire car contrairement à l'ancien
  // Cloudflare Pages, le nouveau modèle Workers ne compile plus /functions
  // automatiquement. dist/worker/index.js est commité volontairement (voir
  // .gitignore) : le build_command du déclencheur Cloudflare Workers
  // Builds pour les branches non-production ne s'exécute pas en pratique
  // (seul celui de `main` le fait, malgré un réglage identique dans le
  // dashboard — limite du produit constatée le 2026-08-14, pas un choix).
  // À CHAQUE MODIFICATION de functions/api/*.js ou lib/server/*.js :
  // relancer `npm run build:worker` et commiter dist/worker/index.js.
  "main": "./dist/worker/index.js",
  "assets": {
    "directory": ".",
    // Par défaut, Cloudflare sert les assets statiques AVANT le Worker et
    // répond 404 direct pour tout chemin sans fichier correspondant — le
    // Worker n'est jamais invoqué pour /api/* sans ce réglage explicite
    // (constaté en déploiement réel : /api/reservation-status renvoyait un
    // 404 "assets", jamais atteint par functions/api/reservation-status.js).
    // Voir https://developers.cloudflare.com/workers/static-assets/binding/.
    "run_worker_first": ["/api/*"]
  },
  // Placeholders pour le développement local (`wrangler dev`, KV simulé
  // localement). PAS DES VRAIS NAMESPACES — à remplacer par les id réels
  // une fois créés côté Cloudflare (voir plan de migration, B.5) avant tout
  // déploiement réel s'appuyant sur ces bindings.
  "kv_namespaces": [
    { "binding": "RESERVATIONS_KV", "id": "local-dev-placeholder-reservations" },
    { "binding": "RATE_LIMITS_KV", "id": "local-dev-placeholder-rate-limits" }
  ]
}
