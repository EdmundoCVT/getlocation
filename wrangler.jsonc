{
  "name": "getlocation",
  "compatibility_date": "2026-08-14",
  // Point d'entrée Worker (Phase B de la migration Cloudflare, voir
  // DEPLOIEMENT.md) : route /api/* vers src/api/*, sert le reste via le
  // binding ASSETS ci-dessous. Sans lui, ce fichier ne déclarait que des
  // assets statiques (Phase A) — les fonctions serveur restaient sur
  // Netlify.
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    // Binding utilisé par src/worker.js (env.ASSETS.fetch(request)) pour
    // servir les fichiers statiques une fois qu'un `main` Worker est
    // déclaré.
    "binding": "ASSETS",
    // Équivalent Cloudflare du `pretty_urls = true` de netlify.toml : sert
    // /vehicules depuis vehicules.html sans redirection. Déclaré
    // explicitement (comportement par défaut de toute façon) pour la même
    // raison que dans netlify.toml : garantir ce comportement par la
    // configuration versionnée plutôt que par un réglage implicite.
    "html_handling": "auto-trailing-slash"
  },
  // Espaces de noms Cloudflare KV (remplacent Netlify Blobs, voir
  // DEPLOIEMENT.md) : RESERVATIONS_KV stocke les réservations,
  // RATE_LIMITS_KV les compteurs anti-abus. Les "id" ci-dessous sont des
  // PLACEHOLDERS — le déploiement échoue tant qu'ils n'ont pas été
  // remplacés par de vrais identifiants (`wrangler kv namespace create ...`,
  // voir DEPLOIEMENT.md, Phase B) : c'est volontaire, pour ne jamais
  // déployer silencieusement contre un espace de noms inexistant.
  "kv_namespaces": [
    { "binding": "RESERVATIONS_KV", "id": "3ca8121a81df4b7c91772f1579b62cdf" },
    { "binding": "RATE_LIMITS_KV", "id": "8c4fc8e9a1e643b6907168639c1617ca" }
  ],
  // Base D1 du mini-back-office agence (Lots 1-3, voir CLAUDE.md) :
  // sessions/connexions (0001), clients/locations/paiements/cautions
  // (0002), file de synchronisation Google Sheets (0003). database_id réel
  // (créée via `wrangler d1 create getlocation-agency`, confirmée par
  // `wrangler d1 list` le 2026-09-09) — migrations pas encore appliquées à
  // ce stade (num_tables=0 à la création).
  "d1_databases": [
    {
      "binding": "AGENCY_DB",
      "database_name": "getlocation-agency",
      "database_id": "0434ec7b-2b20-4dd6-8408-96e027dc0dbd",
      "migrations_dir": "migrations"
    }
  ],
  // Stockage privé des permis, pièces d'identité et justificatifs transmis
  // après paiement. Le bucket n'est jamais exposé publiquement : seul le
  // Worker y accède via ce binding.
  "r2_buckets": [
    { "binding": "DOCUMENTS_BUCKET", "bucket_name": "getlocation-documents" }
  ],
  // Relances et planning agence quotidiens. Les expressions Cron Cloudflare
  // utilisent UTC : 06:00 UTC correspond à 07:00 en hiver et 08:00 en été
  // en France métropolitaine.
  "triggers": { "crons": ["0 6 * * *"] }
}
